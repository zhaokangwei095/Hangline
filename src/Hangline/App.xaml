<Application x:Class="Hangline.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <!-- No StartupUri: a line-drying app has no main window. It lives in the
         tray, and every window it opens is transparent, topmost and never
         activated. ShutdownMode must be explicit or closing one overlay would
         quit the app. -->
    <Application.Resources />
</Application>
